# ==============================================================================
# Git Ignore Rules for Homelab Repository
# Ensures zero secrets, runtime databases, keys, or logs are committed.
# ==============================================================================

# Environment variables & credentials
.env
.env.*
*.env
!.env.example

# Service runtime volumes and data directories
/data/
data/
**/data/**

# Private keys, certificates & secrets
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# SQLite and relational database storage
*.db
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sql

# Logs and runtime diagnostics
*.log
logs/

# Backups and temporary files
*.bak
*.tmp
*.temp
tmp/
temp/
*.tar
*.tar.gz
*.tgz
*.zip

# Operating System & Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.cache/
