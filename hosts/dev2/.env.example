# ==============================================================================
# Firefly III Environment Configuration (dev2)
# ==============================================================================
TZ=UTC
APP_ENV=production
APP_DEBUG=false
# Generate 32 char random key: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32
APP_KEY=changeme_32_characters_random_key_
APP_URL=https://dev2.<your-tailnet>.ts.net
TRUSTED_PROXIES=**

# Database Settings
DB_CONNECTION=mysql
DB_HOST=firefly_db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=change_this_secure_database_password

# Logging & Performance (tuned for 1GB RAM)
APP_LOG_LEVEL=warning
AUDIT_LOG_LEVEL=warning
SEND_REPORT_DATA=false
AUTHENTICATION_GUARD=web

# ==============================================================================
# Firefly III Data Importer Configuration
# ==============================================================================
FIREFLY_III_URL=http://firefly_app:8080
VANITY_URL=https://dev2.<your-tailnet>.ts.net
# Generate Personal Access Token in Firefly III: Profile -> OAuth -> Personal Access Tokens
# FIREFLY_III_ACCESS_TOKEN=your_personal_access_token_here
FALLBACK_LOCALE=en_US
CAN_POST_FILES=true
CAN_POST_AUTOIMPORT=true
AUTO_IMPORT_SECRET=changeme_auto_import_secret_32_characters
IMPORT_DIR_ALLOWLIST=/import

