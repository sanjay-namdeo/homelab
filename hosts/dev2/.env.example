# ==============================================================================
# Environment Configuration (dev2)
# ==============================================================================
TZ=Asia/Kolkata

# ==============================================================================
# Obsidian WebDAV Sync & Flatnotes Web Editor Configuration
# ==============================================================================
WEBDAV_USERNAME=obsidian
WEBDAV_PASSWORD=change_this_secure_webdav_password

FLATNOTES_AUTH_TYPE=password
FLATNOTES_USERNAME=obsidian
FLATNOTES_PASSWORD=change_this_secure_flatnotes_password
FLATNOTES_SECRET_KEY=change_this_secret_key_64_hex_chars

# ==============================================================================
# Cloudflare R2 Encrypted Off-Site Backup Configuration
# ==============================================================================
R2_ACCOUNT_ID=
R2_BUCKET_NAME=homelab
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=

# ==============================================================================
# Beszel Server Monitoring Hub & Agent Configuration
# ==============================================================================
# Public key copied from Beszel Hub UI ("Add System") or generated in /opt/homelab/data/dev2/beszel/data/id_ed25519.pub
BESZEL_KEY=


