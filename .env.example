# ==============================================================================
# Homelab Environment Configuration Template — Single Source of Truth
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#   chmod 600 .env
# All hosts (dev1, dev2) and all scripts source this single file.
# hosts/dev1/.env and hosts/dev2/.env should be symlinks to /opt/homelab/.env.
# ==============================================================================

# ------------------------------------------------------------------------------
# Owner Identity (used by scripts and documentation)
# ------------------------------------------------------------------------------
# The Linux system username running homelab services (used in PATH exports, etc.)
SYSTEM_USER=your-linux-username

# Your GitHub username (used in clone URLs and documentation)
GITHUB_USERNAME=your-github-username

# ------------------------------------------------------------------------------
# Timezone
# ------------------------------------------------------------------------------
# Server Timezone (e.g., Asia/Kolkata, UTC, America/New_York, Europe/London)
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# Vaultwarden Configuration
# ------------------------------------------------------------------------------
# Set SIGNUPS_ALLOWED=false after registering your initial account to prevent
# unauthorized user registrations.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=false
WEBSOCKET_ENABLED=true

# Optional: Set an Admin Token to access the /admin panel in Vaultwarden
# Generate a strong token with: openssl rand -base64 48
# ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# Tailscale Network Settings (dev1 — Private Mesh & MagicDNS)
# ------------------------------------------------------------------------------
# Tailscale CGNAT IP address for this machine (find with: tailscale ip -4)
TAILSCALE_IP=100.x.y.z

# Tailscale machine hostname and tailnet domain (find with: tailscale status)
TAILSCALE_HOSTNAME=your-node
TAILNET_NAME=your-tailnet.ts.net

# Full Tailscale MagicDNS FQDN for HTTPS / TLS certificate generation
TAILSCALE_FQDN=your-node.your-tailnet.ts.net

# ------------------------------------------------------------------------------
# Tailscale Network Settings (dev2 — multi-host)
# ------------------------------------------------------------------------------
DEV1_TAILSCALE_FQDN=dev1.your-tailnet.ts.net
DEV1_TAILSCALE_IP=100.x.y.z
DEV2_TAILSCALE_FQDN=dev2.your-tailnet.ts.net
DEV2_TAILSCALE_IP=100.x.y.z

# ------------------------------------------------------------------------------
# SMTP Configuration (e.g. Brevo — shared by Vaultwarden and Gatus)
# Change SMTP_FROM and ALERT_EMAIL here to update everywhere.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain.com
SMTP_FROM_NAME=Homelab
SMTP_TIMEOUT=15
SMTP_AUTH_MECHANISM=Plain

# Alert recipient — change this one line to redirect all alert emails
ALERT_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# Obsidian WebDAV (dev1) & Flatnotes (dev2)
# ------------------------------------------------------------------------------
WEBDAV_USERNAME=obsidian
WEBDAV_PASSWORD=change_this_secure_webdav_password
# Base64 of "obsidian:<WEBDAV_PASSWORD>" — regenerate with:
#   echo -n "obsidian:<password>" | base64
WEBDAV_BASIC_AUTH=

FLATNOTES_AUTH_TYPE=password
FLATNOTES_USERNAME=obsidian
FLATNOTES_PASSWORD=change_this_secure_flatnotes_password
# Generate with: openssl rand -hex 32
FLATNOTES_SECRET_KEY=change_this_secret_key_64_hex_chars

# ------------------------------------------------------------------------------
# Beszel Server Monitoring
# ------------------------------------------------------------------------------
# Public key copied from Beszel Hub UI on dev2 ("Add System")
BESZEL_KEY=

# ------------------------------------------------------------------------------
# Cloudflare R2 Encrypted Off-Site Backup Configuration
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET_NAME=homelab
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=
